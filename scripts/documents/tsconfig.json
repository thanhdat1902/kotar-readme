{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": []
  },
  "include": [
    "**/*.ts",
    "../types/**/*.d.ts",
    "../../**/*.d.ts"
  ],
  "files": [
    "node_modules/@sysml/web/runtime/sysml.d.ts",
    "document-modules.d.ts"
  ],
  "exclude": [
    "../../node_modules/**",
    "../../**/node_modules/**"
  ]
}
